{
  "name": "pi-splash",
  "version": "0.3.0",
  "description": "A custom startup splash screen for Pi with a rotating π or Pi logo",
  "type": "module",
  "files": [
    "splash.ts",
    "art.ts",
    "config.ts",
    "instructions.ts",
    "palette.ts",
    "pi3d.ts",
    "logo3d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "splash",
    "splash-screen",
    "startup",
    "ascii-art"
  ],
  "author": "Matthias Vallentin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-splash.git"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types *.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./splash.ts"
